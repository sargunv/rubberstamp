{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/.wrangler",
    "mise.lock",
    "pnpm-lock.yaml",
    "apps/worker/worker-configuration.d.ts",
    "apps/web/src/routeTree.gen.ts",
  ],
  "json": { "preferSingleLine": true },
  "markdown": { "textWrap": "always" },
  "oxc": {
    "associations": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs"],
    "experimentalSortImports": { "newlinesBetween": true },
  },
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.27.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:@dprint/oxc@0.47.0"
  ],
}
