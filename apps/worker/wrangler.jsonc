{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rubberstamp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "rubberstamp.sargunv.dev", "custom_domain": true }],
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23li79Tp7Nqf6OsCCb",
    "JEV_MODEL": "jev-latest",
    "PRIVATE_ALLOWLIST": "sargunv/*,maplibre/*,stringline-app/*",
    // Jev input tokens per UTC month. Jev costs $0.042 per million input
    // tokens, so 24M is about $1. Accounts override the per-installation budget.
    "BUDGETS": { "installation": 24000000, "global": 240000000, "accounts": {} }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rubberstamp",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "STATES", "bucket_name": "rubberstamp-states" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "rubberstamp-jobs" }],
    "consumers": [
      {
        "queue": "rubberstamp-jobs",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "rubberstamp-jobs-dlq"
      }
    ]
  },
  "secrets": {
    "required": [
      "GITHUB_PRIVATE_KEY",
      "GITHUB_WEBHOOK_SECRET",
      "TYPESAFE_API_KEY"
    ]
  }
}
