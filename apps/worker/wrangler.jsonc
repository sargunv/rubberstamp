{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rubberstamp",
  "account_id": "6cda5be3bf367f2885f3696d3c9b2653",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "rubberstamp.sargunv.dev", "custom_domain": true }],
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23li79Tp7Nqf6OsCCb",
    "APP_SLUG": "rubberstamp-bot",
    // Where the web app lives; sign-in returns here. .dev.vars overrides it.
    "APP_ORIGIN": "https://rubberstamp.sargunv.dev",
    "JEV_MODEL": "jev-latest",
    "PRIVATE_ALLOWLIST": "sargunv/*,maplibre/*,stringline-app/*",
    // Jev input tokens per UTC month, for labeling and previews alike. Jev
    // costs $0.042 per million input tokens, so 24M is about $1. Accounts
    // override the per-installation budget.
    "BUDGETS": {
      "installation": 24000000,
      "global": 240000000,
      "accounts": { "maplibre": 100000000 }
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rubberstamp",
      "migrations_dir": "migrations"
    }
  ],
  // Daily cleanup of old label runs.
  "triggers": { "crons": ["17 4 * * *"] },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ci/*", "/webhooks/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PREVIEWS", "class_name": "RepoPreviews" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoPreviews"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "rubberstamp-jobs" }],
    "consumers": [
      {
        "queue": "rubberstamp-jobs",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "rubberstamp-jobs-dlq"
      }
    ]
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "GITHUB_PRIVATE_KEY",
      "GITHUB_WEBHOOK_SECRET",
      "SESSION_SECRET",
      "TYPESAFE_API_KEY"
    ]
  }
}
